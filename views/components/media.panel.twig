<!-- MEDIA PANEL TOGGLE -->
<button id="mediaToggleBtn"
    onclick="toggleMediaPanel()"
    class="fixed bottom-5 right-5 bg-blue-600 text-white 
           w-12 h-12 rounded-full shadow-lg 
           flex items-center justify-center z-50 hover:bg-blue-700 transition">

    {{ icon('images', 'w-5 h-5')|raw }}
</button>

<!-- MEDIA PANEL -->
<div id="mediaPanel"
     class="fixed top-0 right-0 w-[320px] h-full bg-white border-l shadow-lg transform translate-x-full transition z-40 overflow-y-auto">

    <div class="p-4 border-b font-semibold flex justify-between">
        Media Library
        <button onclick="toggleMediaPanel()">✕</button>
    </div>

	<div class="p-3 border-b space-y-2">

	    <!-- TYPE FILTER -->
	    <select id="mediaTypeFilter"
		class="w-full border rounded px-2 py-1 text-sm">
		<option value="">All Types</option>
		<option value="image">Images</option>
		<option value="video">Videos</option>
		<option value="icon">Icons</option>
		<option value="file">Files</option>
	    </select>

	    <!-- SEARCH -->
	    <input type="text"
		id="mediaSearch"
		placeholder="Search title or alt..."
		class="w-full border rounded px-2 py-1 text-sm">

	</div>

    <div id="mediaList" class="p-3 grid grid-cols-2 gap-2"></div>

</div>

<script>
let MEDIA_CACHE = [];
let MEDIA_PAGE = 1;
const MEDIA_PER_PAGE = 20;
let MEDIA_LOADING = false;

function getIcon(type) {
    if (type === 'video') {
        return `
        <svg xmlns="http://www.w3.org/2000/svg" 
             class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2"
             viewBox="0 0 24 24">
            <polygon points="23 7 16 12 23 17 23 7"></polygon>
            <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
        </svg>`;
    }

    if (type === 'file') {
        return `
        <svg xmlns="http://www.w3.org/2000/svg" 
             class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2"
             viewBox="0 0 24 24">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12
                     a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
        </svg>`;
    }

    return '';
}

async function copyMediaTag(item, variantKey) {

    const variants = item.variants || {};
    const src = variants[variantKey] || item.original;

    if (!src) {
        alert('No valid source found');
        return;
    }

    let mediaType = 'file';
    const type = item.type || '';

    if (type.startsWith('image/')) mediaType = 'image';
    else if (type.startsWith('video/')) mediaType = 'video';
    else if (type === 'image/svg+xml') mediaType = 'icon';

    const tag = `<rnd-media 
type="${mediaType}"
src="${src}"
alt="${item.alt || ''}"
title="${item.title || ''}"
></rnd-media>`;

    // =========================
    // MODERN CLIPBOARD
    // =========================
    if (navigator.clipboard && navigator.clipboard.writeText) {
        try {
            await navigator.clipboard.writeText(tag);
            showToast('Copied: ' + variantKey);
            return;
        } catch (err) {
            console.warn('Clipboard API failed, fallback...', err);
        }
    }

    // =========================
    // FALLBACK (ALWAYS WORKS)
    // =========================
    fallbackCopy(tag);
}

function fallbackCopy(text) {
    const textarea = document.createElement('textarea');

    textarea.value = text;
    textarea.style.position = 'fixed';
    textarea.style.left = '-9999px';

    document.body.appendChild(textarea);
    textarea.select();

    try {
        document.execCommand('copy');
        showToast('Copied (fallback)');
    } catch (err) {
        alert('Copy failed. Please copy manually.');
    }

    document.body.removeChild(textarea);
}

function showToast(msg) {
    const el = document.createElement('div');
    el.textContent = msg;

    el.className = `
        fixed bottom-20 right-5 
        bg-black text-white text-xs px-3 py-1 rounded shadow z-50
    `;

    document.body.appendChild(el);

    setTimeout(() => el.remove(), 1500);
}

function toggleMediaPanel() {
    const panel = document.getElementById('mediaPanel');
    const btn   = document.getElementById('mediaToggleBtn');

    const isOpen = !panel.classList.contains('translate-x-full');

    panel.classList.toggle('translate-x-full');

    // 🔥 hide button when open
    if (isOpen) {
        btn.classList.remove('hidden');
    } else {
        btn.classList.add('hidden');
    }
}

// ===============================
// LOAD MEDIA
// ===============================
async function loadMedia() {
    const res = await fetch('{{ route('admin.media.json') }}');
    const json = await res.json();

    MEDIA_CACHE = json.data || [];

    renderMedia();
}

// ===============================
// FILTER + SEARCH
// ===============================
function getFilteredMedia() {
    const type = document.getElementById('mediaTypeFilter').value;
    const search = document.getElementById('mediaSearch').value.toLowerCase();

    return MEDIA_CACHE.filter(item => {

        // 🔥 detect type
        let mediaType = 'file';

        if (item.type?.startsWith('image/')) mediaType = 'image';
        else if (item.type?.startsWith('video/')) mediaType = 'video';
        else if (item.type === 'image/svg+xml') mediaType = 'icon';

        // FILTER TYPE
        if (type && mediaType !== type) return false;

        // SEARCH
        const text = (item.title + ' ' + item.alt).toLowerCase();
        if (search && !text.includes(search)) return false;

        return true;
    });
}

// ===============================
// RENDER
// ===============================
function renderMedia(reset = true) {

    const container = document.getElementById('mediaList');

    if (reset) {
        container.innerHTML = '';
        MEDIA_PAGE = 1;
    }

    const items = getFilteredMedia();

    const start = (MEDIA_PAGE - 1) * MEDIA_PER_PAGE;
    const end   = start + MEDIA_PER_PAGE;

    const slice = items.slice(start, end);

    if (reset && !slice.length) {
        container.innerHTML = `<div class="text-xs text-gray-400 col-span-2 text-center p-4">No media found</div>`;
        return;
    }

    slice.forEach(item => {

        const el = document.createElement('div');
        el.className = "border rounded overflow-hidden hover:shadow transition p-1";

        const type = item.type || '';

        // ===============================
        // PREVIEW BLOCK
        // ===============================
        let content = '';

        if (type.startsWith('image/')) {

            const thumb =
                item.variants?.sm ||
                item.variants?.original ||
                item.original;

            content = `<img src="${thumb}" class="w-full h-24 object-cover">`;

        } else if (type.startsWith('video/')) {

            content = `
            <div class="w-full h-24 flex flex-col items-center justify-center bg-gray-100 text-gray-500">
                <div class="mb-1">${getIcon('video')}</div>
                <span class="text-[10px] uppercase">Video</span>
            </div>`;

        } else {

            content = `
            <div class="w-full h-24 flex flex-col items-center justify-center bg-gray-100 text-gray-400">
                <div class="mb-1">${getIcon('file')}</div>
                <span class="text-[10px] uppercase">File</span>
            </div>`;
        }

        // ===============================
        // VARIANTS (SAFE)
        // ===============================
        let variants = item.variants || {};

        if (!Object.keys(variants).length && item.original) {
            variants = { original: item.original };
        }

        let variantButtons = '';

        Object.entries(variants).forEach(([key]) => {
            variantButtons += `
                <button 
                    class="variant-btn text-[10px] px-1 py-0.5 bg-gray-200 rounded hover:bg-blue-600 hover:text-white"
                    data-variant="${key}">
                    ${key}
                </button>
            `;
        });

        // ===============================
        // FINAL HTML
        // ===============================
        el.innerHTML = `
            ${content}
            <div class="text-xs p-1 truncate">${item.title || item.id}</div>
            <div class="flex flex-wrap gap-1 p-1">
                ${variantButtons}
            </div>
        `;

        // ✅ NOW bind events (after HTML exists)
        el.querySelectorAll('.variant-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                copyMediaTag(item, btn.dataset.variant);
            });
        });

        container.appendChild(el);
    });

    MEDIA_LOADING = false;
}

// ===============================
// Filters
// ===============================

function getFilters() {
    return {
        type: document.getElementById('mediaTypeFilter').value,
        search: document.getElementById('mediaSearch').value
    };
}

function saveFilters() {
    localStorage.setItem('mediaFilters', JSON.stringify(getFilters()));
}

function loadFilters() {
    const saved = JSON.parse(localStorage.getItem('mediaFilters') || '{}');

    if (saved.type) {
        document.getElementById('mediaTypeFilter').value = saved.type;
    }

    if (saved.search) {
        document.getElementById('mediaSearch').value = saved.search;
    }
}

// ===============================
// EVENTS
// ===============================
document.addEventListener('DOMContentLoaded', () => {

    loadFilters();   // 🔥 restore first
    loadMedia();

    document.getElementById('mediaTypeFilter')
        .addEventListener('change', () => {
            saveFilters();
            renderMedia(true);
        });

    document.getElementById('mediaSearch')
        .addEventListener('input', () => {
            saveFilters();
            renderMedia(true);
        });
});

document.addEventListener('DOMContentLoaded', () => {
    const panel = document.getElementById('mediaPanel');

    panel.addEventListener('scroll', () => {
        const nearBottom =
            panel.scrollTop + panel.clientHeight >= panel.scrollHeight - 100;

        if (nearBottom && !MEDIA_LOADING) {
            MEDIA_LOADING = true;
            MEDIA_PAGE++;
            renderMedia(false);
        }
    });
});


</script>
