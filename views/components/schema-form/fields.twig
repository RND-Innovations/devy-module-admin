{#
--------------------------------------------
Text
--------------------------------------------
#}

{% if field.type == 'text' %}

    {% include "@Admin/components/form-fields/field-input.twig" with {
        label: field.label,
        name: inputName,
        value: value,
        hint: field.hint ?? ''
    } %}

{% endif %}

{#
--------------------------------------------
Number
--------------------------------------------
#}

{% if field.type == 'number' %}

    {% include "@Admin/components/form-fields/field-input.twig" with {
        type: 'number',
        label: field.label,
        name: inputName,
        value: value,
        hint: field.hint ?? ''
    } %}

{% endif %}

{#
--------------------------------------------
Password
--------------------------------------------
#}

{% if field.type == 'password' %}

    {% include "@Admin/components/form-fields/field-password.twig" with {
	label: field.label,
	name: inputName,
	value: value,
	write_only: field.write_only ?? false,
	hint: field.hint ?? ''
    } %}

{% endif %}

