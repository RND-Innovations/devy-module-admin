{#
--------------------------------------------
Select
--------------------------------------------
#}

{% if field.type == 'select' %}

    {% if field.options == 'themes' %}
        {% set options = themes %}
    {% else %}
        {% set options = field.options %}
    {% endif %}

    {% include "@Admin/components/form-fields/field-select.twig" with {
        label: field.label,
        name: inputName,
        value: value,
        hint: field.hint ?? '',
        options: options
    } %}

{% endif %}


