	value: value,
	hint: field.hint ?? ''
    } %}

{% endif %}


{#
--------------------------------------------
Repeater
--------------------------------------------
#}

{% if field.type == 'repeater' %}

    {% include "@Admin/components/schema-form/field-repeater.twig" with {
        inputName: inputName,
        value: value,
        field: field
    } %}

{% endif %}

