<div class="bg-white border rounded-xl p-5 shadow-sm">
    {% if title is defined %}
        <h3 class="font-semibold mb-3 text-gray-700">
            {{ title }}
        </h3>
    {% endif %}

    {% if text is defined %}
        <p class="mb-5 text-gray-500">
            {{ text }}
        </p>
    {% endif %}
    
    {% block content %}{% endblock %}
</div>
