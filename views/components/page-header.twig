<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 mb-4">

    {# LEFT SIDE #}
    <div class="flex items-center gap-3">

        {# 🔙 BACK BUTTON (perfect circle + centered) #}
        {% if back %}
            <a href="{{ back }}"
               class="flex items-center justify-center w-10 h-10 rounded-full
                      bg-gray-100 hover:bg-gray-200 text-gray-700
                      transition shrink-0">

                {{ icon('back', 'w-4 h-4')|raw }}

            </a>
        {% endif %}

        {# TITLE BLOCK #}
        <div class="flex flex-col justify-center">

            <h1 class="text-xl font-semibold flex items-center gap-2 leading-tight">
                {% if icon %}
                    {{ icon(icon, 'w-5 h-5')|raw }}
                {% endif %}
                {{ title }}
            </h1>

            {% if subtitle %}
                <p class="text-sm text-gray-500 mt-0.5">
                    {{ subtitle }}
                </p>
            {% endif %}

        </div>

    </div>

	{# RIGHT SIDE #}
	<div class="flex items-center gap-2 flex-wrap w-full md:w-auto justify-end md:justify-end">

	    {% if action %}
		<a href="{{ action.url }}"
		   class="bg-blue-600 text-white px-3 py-1 rounded">
		    {{ action.label }}
		</a>
	    {% endif %}

	    {% block actions %}{% endblock %}

	</div>

</div>
