{% set style = field.style ?? 'info' %}

{% set styles = {
    info: {
        icon: 'info',
        class: 'border-blue-300 bg-blue-100 text-blue-800'
    },
    success: {
        icon: 'circle-check',
        class: 'border-green-300 bg-green-100 text-green-800'
    },
    warning: {
        icon: 'triangle-alert',
        class: 'border-yellow-300 bg-yellow-100 text-yellow-800'
    },
    danger: {
        icon: 'circle-alert',
        class: 'border-red-300 bg-red-100 text-red-800'
    }
} %}

{% set notice = styles[style] ?? styles.info %}

<div class="border rounded-lg p-4 {{ notice.class }}">

    <div class="flex items-start gap-3">

        {{ icon(field.icon??'devy', 'w-4 h-4')|raw }} 

        <div class="text-sm">
            {{ field.text|default('')|raw }}
        </div>

    </div>

</div>
