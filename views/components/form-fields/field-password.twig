<div x-data="{ show:false }">

    {% if label %}
        <label class="block text-sm font-medium text-gray-700 mb-1">
            {{ label }}
        </label>
    {% endif %}

    <div class="flex items-center border rounded-lg px-3 py-2 focus-within:ring-2 focus-within:ring-blue-500">

        <input
            :type="show ? 'text' : 'password'"
            name="{{ name }}"
            value="{{ value|default('') }}"
            autocomplete="off"
            class="w-full outline-none">

        <button
            type="button"
            @click="show = !show"
            class="ml-2 text-gray-500 hover:text-gray-700">

            <span x-show="!show">
                {{ icon('eye', 'w-5 h-5')|raw }}
            </span>

            <span x-show="show">
                {{ icon('eye-off', 'w-5 h-5')|raw }}
            </span>

        </button>

    </div>

    {% if hint %}
        <p class="text-xs text-gray-400 mt-1">
            {{ hint }}
        </p>
    {% endif %}

    {% if write_only %}
       <div class="m-2 rounded-lg bg-amber-50 border border-amber-200 px-3 py-2 text-xs text-amber-700">
	  This value is hidden for security. Leave the field empty to keep the current value.
       </div>
    {% endif %}

</div>
