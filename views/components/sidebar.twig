<aside
    class="fixed md:translate-x-0 md:static z-50
           inset-y-0 left-0 w-64
           bg-gray-900 text-white
           transform transition-transform duration-200 -translate-x-full
           flex flex-col
           overflow-hidden"
    :class="sidebarOpen ? 'translate-x-0' : ''"
>

    <!-- Header -->
    <div class="p-4 border-b border-gray-800 flex justify-between items-center md:hidden">
        <span class="font-semibold">{{ settings.get('site.name') }}</span>
        <button @click="sidebarOpen = false">✕</button>
    </div>

    <!-- Scrollable area -->
    <div class="flex-1 overflow-y-auto p-4">

        {% set nav = navigation() %}

        <nav class="space-y-2">

            {% for item in nav.admin %}

                {% if item.children is defined and item.children %}

                    <div x-data="{ open: true }">

                        <button @click="open = !open"
                            class="w-full flex items-center gap-2 px-3 py-2 rounded hover:bg-gray-700">

                            {% if item.icon %}
                                {{ icon(item.icon, 'w-4 h-4 shrink-0')|raw }}
                            {% endif %}

                            <span class="flex-1 text-left">{{ item.title }}</span>

                        </button>

                        <div x-show="open" class="ml-4 mt-1 space-y-1">

                            {% for child in item.children %}
                                <a href="{{ child.url }}"
                                   class="flex items-center gap-2 px-3 py-1 text-sm text-gray-300 hover:bg-gray-700 rounded">

                                    {% if child.icon %}
                                        {{ icon(child.icon, 'w-4 h-4 shrink-0')|raw }}
                                    {% endif %}

                                    <span>{{ child.title }}</span>

                                </a>
                            {% endfor %}

                        </div>

                    </div>

                {% else %}

                    <a href="{{ item.url }}"
                       class="flex items-center gap-2 px-3 py-2 rounded hover:bg-gray-700">

                        {% if item.icon %}
                            {{ icon(item.icon, 'w-4 h-4 shrink-0')|raw }}
                        {% endif %}

                        <span>{{ item.title }}</span>
                    </a>

                {% endif %}

            {% endfor %}

        </nav>

    </div>

    <!-- Footer (fixed at bottom) -->
    <div class="p-4 border-t border-gray-800">
        {% include "@Admin/components/footer.twig" %}
    </div>

</aside>
