{% set stats = hook('admin.dashboard.stats', []) %}
{% if stats is not iterable %}
    {% set stats = [] %}
{% endif %}

<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5">

    {# Default fallback #}
    {% if stats is empty %}

        <div class="relative overflow-hidden rounded-3xl border border-zinc-200 bg-[#fafafa] shadow-lg p-5">

            <div class="absolute top-0 right-0 w-32 h-32 bg-blue-100 rounded-full blur-3xl opacity-60"></div>

            <div class="relative">

                <div class="flex items-center justify-between">

                    <div>

                        <div class="text-xs font-bold uppercase tracking-wider text-zinc-500">
                            Welcome
                        </div>

                        <div class="mt-3 text-3xl font-black text-zinc-900">
                            👋
                        </div>

                    </div>

                </div>

                <p class="mt-5 text-sm text-zinc-600">
                    No stats available yet.
                </p>

            </div>

        </div>

    {% endif %}

    {% for item in stats %}

        {% set color = item.color|default('blue') %}

        <div class="group relative overflow-hidden rounded-3xl border border-zinc-200 bg-[#fafafa] shadow-lg hover:shadow-2xl hover:-translate-y-1 transition-all duration-300">

            {# Glow Effect #}
            <div class="
                absolute -top-10 -right-10 w-40 h-40 rounded-full blur-3xl opacity-60
                {% if color == 'emerald' %} bg-emerald-100
                {% elseif color == 'amber' %} bg-amber-100
                {% elseif color == 'rose' %} bg-rose-100
                {% elseif color == 'violet' %} bg-violet-100
                {% else %} bg-blue-100
                {% endif %}
            "></div>

            <div class="relative p-5 flex flex-col h-full">

                {# TOP #}
                <div class="flex items-start justify-between gap-4">

                    <div>

                        <div class="text-[11px] font-black uppercase tracking-[0.15em] text-zinc-500">
                            {{ item.title|default('Item') }}
                        </div>

                        <div class="mt-3 text-4xl font-black tracking-tight text-zinc-900 leading-none">

                            {{ item.value|default('—') }}

                        </div>

                    </div>

                    {% if item.icon %}

                        <div class="
                            w-14 h-14 rounded-2xl flex items-center justify-center shadow-md shrink-0
                            {% if color == 'emerald' %}
                                bg-gradient-to-br from-emerald-500 to-green-600 text-white
                            {% elseif color == 'amber' %}
                                bg-gradient-to-br from-amber-400 to-orange-500 text-white
                            {% elseif color == 'rose' %}
                                bg-gradient-to-br from-rose-500 to-pink-600 text-white
                            {% elseif color == 'violet' %}
                                bg-gradient-to-br from-violet-500 to-purple-600 text-white
                            {% else %}
                                bg-gradient-to-br from-blue-500 to-indigo-600 text-white
                            {% endif %}
                        ">

                            {{ icon(item.icon, 'w-6 h-6')|raw }}

                        </div>

                    {% endif %}

                </div>

			<div class="mt-auto pt-5 flex items-end justify-between gap-4">

			    {# META #}
			    <div>

				{% if item.meta %}
				    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white border border-zinc-200 text-xs font-semibold text-zinc-600 shadow-sm">

					<span class="w-1.5 h-1.5 rounded-full bg-zinc-400"></span>

					{{ item.meta }}

				    </div>
				{% endif %}

			    </div>

			    {# LINK #}
			    {% if item.url %}
				<a href="{{ item.url }}"
				   class="inline-flex items-center gap-2 text-sm font-bold shrink-0
					  {% if color == 'emerald' %}
					      text-emerald-600 hover:text-emerald-700
					  {% elseif color == 'amber' %}
					      text-amber-600 hover:text-amber-700
					  {% elseif color == 'rose' %}
					      text-rose-600 hover:text-rose-700
					  {% elseif color == 'violet' %}
					      text-violet-600 hover:text-violet-700
					  {% else %}
					      text-blue-600 hover:text-blue-700
					  {% endif %}
					  transition">

				    View Details

				    <span class="group-hover:translate-x-1 transition">
					{{ icon('go', 'w-5 h-5')|raw }}
				    </span>

				</a>
			    {% endif %}

			</div>
            </div>

        </div>

    {% endfor %}

</div>
